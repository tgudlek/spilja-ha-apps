#!/bin/bash
# Remote Control recovers from short outages by itself. After some failures it
# gives up and waits for someone to type /remote-control in the terminal,
# which nobody does on an unattended box. Run every 30 s by the session
# service: if the always-on Claude is logged in but has no Remote Control
# connection (or its footer says "/rc failed") on two checks in a row, while
# the internet is reachable, restart it. It continues the conversation and
# reconnects; after "Previous session is unavailable" it starts a new
# conversation instead.
#
# The signal is Claude Code's own session record, ~/.claude/sessions/<pid>.json:
# "bridgeSessionId" is set while Remote Control is connected. Screen text is
# only used for the footer indicator and for choosing a fresh start, never
# for deciding whether to restart (the conversation can quote any message).
# shellcheck source=/dev/null
. /usr/local/lib/claude-addon/common.sh

STATE=/tmp/rc-watchdog
mkdir -p "$STATE"
ok() { echo 0 > "$STATE/bad"; exit 0; }

started="$(cat /tmp/claude-loop.started 2>/dev/null || echo 0)"
[ $(( $(date +%s) - started )) -ge 90 ] || ok          # let it start and connect
[ -s "$HOME/.claude/.credentials.json" ] || ok          # not logged in yet: nothing to connect

loop_pid="$(tmux display-message -p -t "$TMUX_SESSION:claude" '#{pane_pid}' 2>/dev/null)" || ok
pid="$(pgrep -P "$loop_pid" | head -n1)"
[ -n "$pid" ] || ok                                      # between restarts
record="$HOME/.claude/sessions/$pid.json"
[ -f "$record" ] || ok                                   # onboarding, login screen, ...

screen="$(tmux capture-pane -p -J -t "$TMUX_SESSION:claude" 2>/dev/null)"
footer="$(grep -v '^[[:space:]]*$' <<< "$screen" | tail -n 3)"
if jq -e '(.bridgeSessionId // "") != ""' "$record" >/dev/null 2>&1 && ! grep -q '/rc failed' <<< "$footer"; then
    ok
fi

n=$(( $(cat "$STATE/bad" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$STATE/bad"
[ "$n" -ge 2 ] || exit 0

# Offline: a restart can't help, and Claude keeps retrying on its own.
curl -s -m 10 -o /dev/null https://api.anthropic.com/ || exit 0

# At most three restarts an hour; a persistent failure stays visible instead.
recent="$(find "$STATE" -name 'restart.*' -mmin -60 | wc -l)"
if [ "$recent" -ge 3 ]; then
    log "Remote Control still not connected; not restarting (3 restarts in the last hour)"
    exit 0
fi
now="$(date +%s)"
touch "$STATE/restart.$now"
echo 0 > "$STATE/bad"
if grep -v '^[[:space:]]*$' <<< "$screen" | tail -n 8 | grep -q 'Previous session is unavailable'; then
    touch "$FRESH_FLAG"
fi
log "Remote Control not connected; restarting Claude Code"
kill -TERM "$pid" 2>/dev/null
sleep 20
kill -KILL "$pid" 2>/dev/null   # only the process stopped above, never the restarted Claude
exit 0
